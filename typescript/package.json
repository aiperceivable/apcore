{
  "name": "apcore-js",
  "version": "1.0.0-alpha.4",
  "description": "Build once, invoke by code or AI — with schema, ACL, approval, and audit enforced at every call",
  "type": "module",
  "main": "./dist/index.js",
  "browser": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./full": {
      "types": "./dist/full.d.ts",
      "node": "./dist/full.js"
    },
    "./context-keys": {
      "types": "./dist/context-keys.d.ts",
      "default": "./dist/context-keys.js"
    },
    "./config": {
      "types": "./dist/config-entry.d.ts",
      "node": "./dist/config-entry.js"
    },
    "./discovery": {
      "types": "./dist/discovery.d.ts",
      "node": "./dist/discovery.js"
    },
    "./sys-modules": {
      "types": "./dist/sys-modules/entry.d.ts",
      "node": "./dist/sys-modules/entry.js"
    },
    "./events": {
      "types": "./dist/events/entry.d.ts",
      "node": "./dist/events/entry.js"
    },
    "./observability": {
      "types": "./dist/observability/portable.d.ts",
      "default": "./dist/observability/portable.js"
    },
    "./compiler": {
      "types": "./dist/compiler.d.ts",
      "node": "./dist/compiler.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "generate:version": "node scripts/generate-version.js",
    "prepare": "node scripts/generate-version.js",
    "build": "node scripts/generate-version.js && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && pnpm run typecheck:examples",
    "typecheck:examples": "tsc -p tsconfig.examples.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome lint src tests",
    "lint:fix": "biome lint --write src tests",
    "format": "biome format --write src tests",
    "prepublishOnly": "pnpm run build"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aiperceivable/apcore.git",
    "directory": "typescript"
  },
  "homepage": "https://aiperceivable.com",
  "bugs": {
    "url": "https://github.com/aiperceivable/apcore/issues"
  },
  "keywords": [
    "apcore",
    "ai",
    "module",
    "schema",
    "framework",
    "orchestration",
    "llm",
    "agent",
    "json-schema",
    "error-handling",
    "middleware",
    "approval",
    "acl"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@sinclair/typebox": "^0.34.0",
    "js-yaml": "^4.3.2",
    "uuid": "^11.1.1"
  },
  "peerDependencies": {
    "typescript": "^5.5.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^5.1.0",
    "apdev-js": "0.2.4",
    "typescript": "^5.5.0",
    "vitest": "^5.1.0"
  }
}
