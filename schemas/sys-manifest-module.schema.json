{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apcore.dev/schemas/sys-manifest-module.schema.json",
  "title": "system.manifest.module Output",
  "description": "Output schema for the system.manifest.module module.",
  "type": "object",
  "required": ["module_id", "description"],
  "additionalProperties": false,
  "properties": {
    "module_id": {
      "type": "string",
      "description": "Canonical module ID."
    },
    "description": {
      "type": "string",
      "description": "Module description (max 200 characters, plain text)."
    },
    "documentation": {
      "type": ["string", "null"],
      "description": "Extended documentation (max 5000 characters, Markdown allowed)."
    },
    "source_path": {
      "type": ["string", "null"],
      "description": "Source file path relative to extensions root."
    },
    "input_schema": {
      "type": ["object", "null"],
      "description": "Module input JSON Schema."
    },
    "output_schema": {
      "type": ["object", "null"],
      "description": "Module output JSON Schema."
    },
    "annotations": {
      "type": ["object", "null"],
      "description": "Module annotation metadata."
    },
    "tags": {
      "type": "array",
      "description": "Module tags.",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "description": "Declared dependencies. SDK responses carry structured entries. A bare module ID is accepted for legacy data.",
      "items": {
        "anyOf": [
          {"type": "string"},
          {
            "type": "object",
            "required": ["module_id"],
            "additionalProperties": false,
            "properties": {
              "module_id": {
                "type": "string",
                "description": "Canonical ID of the required or optional module."
              },
              "version": {
                "type": ["string", "null"],
                "description": "Version constraint. A missing, empty, or null value means there is no constraint."
              },
              "optional": {
                "type": "boolean",
                "description": "Whether the module can be used when this dependency is missing. Defaults to false if omitted."
              }
            }
          }
        ]
      }
    },
    "metadata": {
      "type": ["object", "null"],
      "description": "Additional module metadata."
    }
  }
}
