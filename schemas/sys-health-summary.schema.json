{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apcore.dev/schemas/sys-health-summary.schema.json",
  "title": "system.health.summary Output",
  "description": "Output schema for the system.health.summary module.",
  "type": "object",
  "required": ["project", "summary", "modules"],
  "additionalProperties": false,
  "properties": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "description": "Project metadata.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Project name."
        },
        "version": {
          "type": ["string", "null"],
          "description": "Project version."
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "description": "Aggregate health statistics.",
      "properties": {
        "total_modules": {
          "type": "integer",
          "description": "Total number of registered modules."
        },
        "healthy": {
          "type": "integer",
          "description": "Number of healthy modules."
        },
        "degraded": {
          "type": "integer",
          "description": "Number of degraded modules."
        },
        "error": {
          "type": "integer",
          "description": "Number of modules in the `error` tier."
        },
        "unknown": {
          "type": "integer",
          "description": "Number of modules that have recorded no calls yet."
        }
      }
    },
    "modules": {
      "type": "array",
      "description": "Per-module health status entries.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "module_id": {
            "type": "string",
            "description": "Canonical module ID."
          },
          "status": {
            "type": "string",
            "description": "Health status. `unknown` means the module has recorded no calls yet; `error` is the top tier, above `degraded`.",
            "enum": ["healthy", "degraded", "error", "unknown"]
          },
          "error_rate": {
            "type": "number",
            "description": "Failed calls over total calls, 0.0-1.0. Zero when the module has recorded no calls.",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "top_error": {
            "type": ["object", "null"],
            "description": "The module's most frequent recorded error, or null when it has none.",
            "additionalProperties": false,
            "required": ["code", "message", "count"],
            "properties": {
              "code": {
                "type": "string",
                "description": "Canonical error code."
              },
              "message": {
                "type": "string",
                "description": "Error message."
              },
              "ai_guidance": {
                "type": ["string", "null"],
                "description": "Remediation guidance for an AI caller, when the error carries one."
              },
              "count": {
                "type": "integer",
                "description": "How many times this error was recorded.",
                "minimum": 1
              }
            }
          }
        }
      }
    }
  }
}
