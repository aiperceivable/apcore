{
  "description": "Cancellation from stream post-processing reaches the consumer after the last data chunk (D-20). Ordinary post-processing failures still end the iterator and emit a diagnostic.",
  "test_cases": [
    {
      "id": "after_middleware_cancellation_reaches_consumer",
      "input": { "chunks": [{"value": 1}], "after_error_code": "EXECUTION_CANCELLED" },
      "expected": { "chunks": [{"value": 1}], "error_code": "EXECUTION_CANCELLED", "on_error_calls": 0, "post_failure_events": 0 }
    },
    {
      "id": "ordinary_after_middleware_failure_is_reported",
      "input": { "chunks": [{"value": 1}], "after_error_code": "MODULE_EXECUTE_ERROR" },
      "expected": { "chunks": [{"value": 1}], "error_code": null, "on_error_calls": 0, "post_failure_events": 1 }
    }
  ]
}
