{
  "description": "Cross-language ID normalization (Algorithm A02)",
  "test_cases": [
    {
      "id": "python_module_path",
      "local_id": "auth.handlers.login_handler",
      "language": "python",
      "expected": "auth.handlers.login_handler"
    },
    {
      "id": "python_class_name",
      "local_id": "auth.LoginHandler",
      "language": "python",
      "expected": "auth.login_handler"
    },
    {
      "id": "typescript_camel_case",
      "local_id": "auth.loginHandler",
      "language": "typescript",
      "expected": "auth.login_handler"
    },
    {
      "id": "typescript_pascal_case",
      "local_id": "Auth.LoginHandler",
      "language": "typescript",
      "expected": "auth.login_handler"
    },
    {
      "id": "go_package_path",
      "local_id": "auth.LoginHandler",
      "language": "go",
      "expected": "auth.login_handler"
    },
    {
      "id": "rust_crate_path",
      "local_id": "auth::login_handler",
      "language": "rust",
      "expected": "auth.login_handler"
    },
    {
      "id": "java_package",
      "local_id": "com.example.auth.LoginHandler",
      "language": "java",
      "expected": "com.example.auth.login_handler"
    },
    {
      "id": "python_already_canonical",
      "local_id": "auth.login",
      "language": "python",
      "expected": "auth.login"
    },
    {
      "id": "typescript_dot_separated",
      "local_id": "auth.handlers.UserService",
      "language": "typescript",
      "expected": "auth.handlers.user_service"
    },
    {
      "id": "rust_double_colon",
      "local_id": "crate::auth::mfa_handler",
      "language": "rust",
      "expected": "crate.auth.mfa_handler"
    },
    {
      "id": "python_acronym_handling",
      "local_id": "api.HTTPClient",
      "language": "python",
      "expected": "api.http_client"
    },
    {
      "id": "typescript_nested_path",
      "local_id": "api.v2.UserProfile",
      "language": "typescript",
      "expected": "api.v2.user_profile"
    },
    {
      "id": "complex_acronym_1",
      "local_id": "HttpApiHandler",
      "language": "python",
      "expected": "http_api_handler"
    },
    {
      "id": "complex_acronym_2",
      "local_id": "DbUrlParser",
      "language": "typescript",
      "expected": "db_url_parser"
    },
    {
      "id": "consecutive_uppercase",
      "local_id": "MY_MODULE.DataXML",
      "language": "python",
      "expected": "my_module.data_xml"
    },
    {
      "id": "id_with_numbers",
      "local_id": "V2.User123Profile",
      "language": "typescript",
      "expected": "v2.user123_profile"
    },
    {
      "id": "double_underscore_preserved",
      "local_id": "read_item_items__item_id__get",
      "language": "python",
      "expected": "read_item_items__item_id__get"
    },
    {
      "id": "triple_underscore_preserved",
      "local_id": "a___b",
      "language": "typescript",
      "expected": "a___b"
    },
    {
      "id": "trailing_underscore_kept",
      "local_id": "getUser_",
      "language": "python",
      "expected": "get_user_"
    },
    {
      "id": "screaming_snake",
      "local_id": "HTTP_SERVER",
      "language": "rust",
      "expected": "http_server"
    },
    {
      "id": "leading_underscore_rejected",
      "local_id": "_lead",
      "language": "python",
      "expected_error": true,
      "expected_normalized": "_lead"
    },
    {
      "id": "non_ascii_rejected_without_transformation",
      "local_id": "getÜber",
      "language": "typescript",
      "expected_error": true,
      "expected_normalized": "getÜber"
    },
    {
      "id": "kebab_case_rejected_without_repair",
      "local_id": "user-profiles",
      "language": "python",
      "expected_error": true,
      "expected_normalized": "user-profiles"
    }
  ]
}
