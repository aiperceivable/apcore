{
  "description": "Event-name canonicalization (Issue #36 / D-34). Verifies framework events are emitted with the canonical apcore.<subsystem>.<event> form, that legacy names are dual-emitted with deprecated:true during the v0.21.x cycle, that glob subscriptions match canonical names, and that health-threshold events use the apcore.health.* subsystem.",
  "test_cases": [
    {
      "id": "canonical_module_registered",
      "trigger": {
        "action": "registry.register",
        "target_id": "math.add"
      },
      "expected": {
        "canonical_event": {
          "event_type": "apcore.registry.module_registered",
          "data_contains": {
            "module_id": "math.add"
          }
        }
      }
    },
    {
      "id": "canonical_module_unregistered",
      "trigger": {
        "action": "registry.unregister",
        "target_id": "math.add"
      },
      "expected": {
        "canonical_event": {
          "event_type": "apcore.registry.module_unregistered",
          "data_contains": {
            "module_id": "math.add"
          }
        }
      }
    },
    {
      "id": "legacy_dual_emit",
      "description": "During v0.21.x, registry register MUST emit BOTH the canonical name and the legacy name, with the legacy event carrying data.deprecated=true.",
      "trigger": {
        "action": "registry.register",
        "target_id": "math.add"
      },
      "expected": {
        "events": [
          {
            "event_type": "apcore.registry.module_registered",
            "data_contains": {
              "module_id": "math.add"
            }
          },
          {
            "event_type": "module_registered",
            "data_contains": {
              "module_id": "math.add",
              "deprecated": true
            }
          }
        ]
      }
    },
    {
      "id": "glob_subscription_registry",
      "description": "An apcore.registry.* glob subscription MUST receive both module_registered and module_unregistered canonical events.",
      "subscription_pattern": "apcore.registry.*",
      "trigger_sequence": [
        {"action": "registry.register", "target_id": "math.add"},
        {"action": "registry.unregister", "target_id": "math.add"}
      ],
      "expected": {
        "received_event_types": [
          "apcore.registry.module_registered",
          "apcore.registry.module_unregistered"
        ]
      }
    },
    {
      "id": "glob_subscription_health",
      "description": "An apcore.health.* glob subscription MUST receive recovered + threshold-exceeded events under the canonical apcore.health.* namespace.",
      "subscription_pattern": "apcore.health.*",
      "trigger_sequence": [
        {"action": "platform_notify.error_threshold_crossed", "target_id": "email.send"},
        {"action": "platform_notify.recovered", "target_id": "email.send"}
      ],
      "expected": {
        "received_event_types": [
          "apcore.health.error_threshold_exceeded",
          "apcore.health.recovered"
        ]
      }
    },
    {
      "id": "health_threshold_canonical",
      "description": "Threshold-crossing events MUST be emitted under apcore.health.* (not apcore.error.* / apcore.latency.*).",
      "trigger_sequence": [
        {
          "action": "platform_notify.error_threshold_crossed",
          "target_id": "email.send",
          "error_rate": 0.15,
          "threshold": 0.10
        },
        {
          "action": "platform_notify.latency_threshold_crossed",
          "target_id": "email.send",
          "p99_latency_ms": 6000.0,
          "threshold": 5000.0
        }
      ],
      "expected": {
        "events": [
          {
            "event_type": "apcore.health.error_threshold_exceeded",
            "data_contains": {
              "module_id": "email.send",
              "error_rate": 0.15,
              "threshold": 0.10
            }
          },
          {
            "event_type": "apcore.health.latency_threshold_exceeded",
            "data_contains": {
              "module_id": "email.send",
              "p99_latency_ms": 6000.0,
              "threshold": 5000.0
            }
          }
        ]
      }
    },
    {
      "id": "legacy_health_dual_emit",
      "description": "During v0.21.x, error/latency threshold events MUST be dual-emitted under both the canonical apcore.health.* form and the legacy apcore.error.* / apcore.latency.* form (deprecated:true).",
      "trigger": {
        "action": "platform_notify.error_threshold_crossed",
        "target_id": "email.send",
        "error_rate": 0.15,
        "threshold": 0.10
      },
      "expected": {
        "events": [
          {
            "event_type": "apcore.health.error_threshold_exceeded",
            "data_contains": {
              "module_id": "email.send"
            }
          },
          {
            "event_type": "apcore.error.threshold_exceeded",
            "data_contains": {
              "module_id": "email.send",
              "deprecated": true
            }
          }
        ]
      }
    },
    {
      "id": "glob_does_not_match_other_subsystem",
      "description": "apcore.registry.* MUST NOT match apcore.health.* events.",
      "subscription_pattern": "apcore.registry.*",
      "trigger": {
        "action": "platform_notify.error_threshold_crossed",
        "target_id": "email.send"
      },
      "expected": {
        "received_event_types": []
      }
    }
  ]
}
