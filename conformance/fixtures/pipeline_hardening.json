{
  "description": "Pipeline execution hardening: fail-fast, replace-step, run_until termination",
  "test_cases": [
    {
      "id": "fail_fast_on_step_error",
      "description": "Pipeline stops at failing step when ignore_errors is false",
      "input": { "step": "validate_input", "raises": true, "ignore_errors": false },
      "expected": { "stopped": true, "steps_executed": ["context_creation", "module_lookup", "validate_input"], "error_code": "PIPELINE_STEP_ERROR" }
    },
    {
      "id": "continue_on_ignored_error",
      "description": "Pipeline continues when step has ignore_errors: true",
      "input": { "step": "validate_input", "raises": true, "ignore_errors": true },
      "expected": { "stopped": false, "continued": true }
    },
    {
      "id": "replace_semantic_no_duplicate",
      "description": "Configuring an existing step replaces it, not duplicates it",
      "input": { "configure_step": "validate_input", "times": 2 },
      "expected": { "step_count_for_name": 1 }
    },
    {
      "id": "run_until_stops_early",
      "description": "Pipeline halts when run_until predicate returns true after step N",
      "input": { "run_until_after": "module_lookup" },
      "expected": { "last_step_executed": "module_lookup", "steps_after_skipped": true }
    },
    {
      "id": "step_lookup_is_not_linear",
      "description": "Pipeline step resolution uses O(1) lookup (verified by implementation)",
      "input": { "step_count": 11 },
      "expected": { "lookup_complexity": "O(1)" }
    }
  ]
}
