{
  "description": "Dependency version constraint enforcement during load-order resolution (spec §5.3, §5.15.2)",
  "test_cases": [
    {
      "id": "exact_match_satisfied",
      "modules": [
        {"module_id": "a", "version": "1.0.0", "dependencies": [{"module_id": "b", "version": "1.2.3"}]},
        {"module_id": "b", "version": "1.2.3", "dependencies": []}
      ],
      "expected": {"outcome": "ok", "load_order": ["b", "a"]}
    },
    {
      "id": "exact_match_violated",
      "modules": [
        {"module_id": "a", "version": "1.0.0", "dependencies": [{"module_id": "b", "version": "1.2.3"}]},
        {"module_id": "b", "version": "1.2.4", "dependencies": []}
      ],
      "expected": {
        "outcome": "error",
        "error_code": "DEPENDENCY_VERSION_MISMATCH",
        "module_id": "a",
        "dependency_id": "b",
        "required": "1.2.3",
        "actual": "1.2.4"
      }
    },
    {
      "id": "gte_constraint_satisfied",
      "modules": [
        {"module_id": "a", "version": "1.0.0", "dependencies": [{"module_id": "b", "version": ">=1.0.0"}]},
        {"module_id": "b", "version": "1.5.0", "dependencies": []}
      ],
      "expected": {"outcome": "ok", "load_order": ["b", "a"]}
    },
    {
      "id": "gte_constraint_violated",
      "modules": [
        {"module_id": "a", "version": "1.0.0", "dependencies": [{"module_id": "b", "version": ">=2.0.0"}]},
        {"module_id": "b", "version": "1.5.0", "dependencies": []}
      ],
      "expected": {
        "outcome": "error",
        "error_code": "DEPENDENCY_VERSION_MISMATCH",
        "module_id": "a",
        "dependency_id": "b",
        "required": ">=2.0.0",
        "actual": "1.5.0"
      }
    },
    {
      "id": "range_constraint_satisfied",
      "modules": [
        {"module_id": "a", "version": "1.0.0", "dependencies": [{"module_id": "b", "version": ">=1.0.0,<2.0.0"}]},
        {"module_id": "b", "version": "1.9.9", "dependencies": []}
      ],
      "expected": {"outcome": "ok", "load_order": ["b", "a"]}
    },
    {
      "id": "range_constraint_violated_upper",
      "modules": [
        {"module_id": "a", "version": "1.0.0", "dependencies": [{"module_id": "b", "version": ">=1.0.0,<2.0.0"}]},
        {"module_id": "b", "version": "2.0.0", "dependencies": []}
      ],
      "expected": {
        "outcome": "error",
        "error_code": "DEPENDENCY_VERSION_MISMATCH",
        "module_id": "a",
        "dependency_id": "b",
        "required": ">=1.0.0,<2.0.0",
        "actual": "2.0.0"
      }
    },
    {
      "id": "caret_constraint_major_nonzero_satisfied",
      "modules": [
        {"module_id": "a", "version": "1.0.0", "dependencies": [{"module_id": "b", "version": "^1.2.3"}]},
        {"module_id": "b", "version": "1.9.0", "dependencies": []}
      ],
      "expected": {"outcome": "ok", "load_order": ["b", "a"]}
    },
    {
      "id": "caret_constraint_major_nonzero_violated",
      "modules": [
        {"module_id": "a", "version": "1.0.0", "dependencies": [{"module_id": "b", "version": "^1.2.3"}]},
        {"module_id": "b", "version": "2.0.0", "dependencies": []}
      ],
      "expected": {
        "outcome": "error",
        "error_code": "DEPENDENCY_VERSION_MISMATCH",
        "module_id": "a",
        "dependency_id": "b",
        "required": "^1.2.3",
        "actual": "2.0.0"
      }
    },
    {
      "id": "caret_constraint_major_zero_minor_nonzero",
      "modules": [
        {"module_id": "a", "version": "1.0.0", "dependencies": [{"module_id": "b", "version": "^0.2.3"}]},
        {"module_id": "b", "version": "0.3.0", "dependencies": []}
      ],
      "expected": {
        "outcome": "error",
        "error_code": "DEPENDENCY_VERSION_MISMATCH",
        "module_id": "a",
        "dependency_id": "b",
        "required": "^0.2.3",
        "actual": "0.3.0"
      }
    },
    {
      "id": "tilde_constraint_three_parts_satisfied",
      "modules": [
        {"module_id": "a", "version": "1.0.0", "dependencies": [{"module_id": "b", "version": "~1.2.3"}]},
        {"module_id": "b", "version": "1.2.9", "dependencies": []}
      ],
      "expected": {"outcome": "ok", "load_order": ["b", "a"]}
    },
    {
      "id": "tilde_constraint_three_parts_violated",
      "modules": [
        {"module_id": "a", "version": "1.0.0", "dependencies": [{"module_id": "b", "version": "~1.2.3"}]},
        {"module_id": "b", "version": "1.3.0", "dependencies": []}
      ],
      "expected": {
        "outcome": "error",
        "error_code": "DEPENDENCY_VERSION_MISMATCH",
        "module_id": "a",
        "dependency_id": "b",
        "required": "~1.2.3",
        "actual": "1.3.0"
      }
    },
    {
      "id": "partial_version_major_only",
      "modules": [
        {"module_id": "a", "version": "1.0.0", "dependencies": [{"module_id": "b", "version": "1"}]},
        {"module_id": "b", "version": "1.5.2", "dependencies": []}
      ],
      "expected": {"outcome": "ok", "load_order": ["b", "a"]}
    },
    {
      "id": "partial_version_major_only_violated",
      "modules": [
        {"module_id": "a", "version": "1.0.0", "dependencies": [{"module_id": "b", "version": "1"}]},
        {"module_id": "b", "version": "2.0.0", "dependencies": []}
      ],
      "expected": {
        "outcome": "error",
        "error_code": "DEPENDENCY_VERSION_MISMATCH",
        "module_id": "a",
        "dependency_id": "b",
        "required": "1",
        "actual": "2.0.0"
      }
    },
    {
      "id": "no_version_constraint_accepts_any",
      "modules": [
        {"module_id": "a", "version": "1.0.0", "dependencies": [{"module_id": "b"}]},
        {"module_id": "b", "version": "99.0.0", "dependencies": []}
      ],
      "expected": {"outcome": "ok", "load_order": ["b", "a"]}
    },
    {
      "id": "optional_dependency_version_mismatch_skipped",
      "modules": [
        {"module_id": "a", "version": "1.0.0", "dependencies": [{"module_id": "b", "version": ">=2.0.0", "optional": true}]},
        {"module_id": "b", "version": "1.0.0", "dependencies": []}
      ],
      "expected": {"outcome": "ok", "skipped_edges": [["a", "b"]]}
    }
  ]
}
