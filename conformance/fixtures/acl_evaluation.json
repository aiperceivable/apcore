{
  "description": "ACL rule evaluation (first-match-wins)",
  "test_cases": [
    {
      "id": "allow_rule_match",
      "rules": [
        {"callers": ["admin"], "targets": ["*"], "effect": "allow"}
      ],
      "default_effect": "deny",
      "caller": "admin",
      "target": "auth.login",
      "expected": true
    },
    {
      "id": "deny_rule_match",
      "rules": [
        {"callers": ["*"], "targets": ["admin.*"], "effect": "deny"}
      ],
      "default_effect": "allow",
      "caller": "user",
      "target": "admin.delete",
      "expected": false
    },
    {
      "id": "first_match_wins",
      "rules": [
        {"callers": ["admin"], "targets": ["*"], "effect": "allow"},
        {"callers": ["admin"], "targets": ["*"], "effect": "deny"}
      ],
      "default_effect": "deny",
      "caller": "admin",
      "target": "anything",
      "expected": true
    },
    {
      "id": "default_deny",
      "rules": [
        {"callers": ["admin"], "targets": ["*"], "effect": "allow"}
      ],
      "default_effect": "deny",
      "caller": "user",
      "target": "auth.login",
      "expected": false
    },
    {
      "id": "default_allow",
      "rules": [],
      "default_effect": "allow",
      "caller": "anyone",
      "target": "anything",
      "expected": true
    },
    {
      "id": "null_caller_becomes_external",
      "rules": [
        {"callers": ["@external"], "targets": ["public.*"], "effect": "allow"}
      ],
      "default_effect": "deny",
      "caller": null,
      "target": "public.api",
      "expected": true
    },
    {
      "id": "multiple_caller_patterns_or",
      "rules": [
        {"callers": ["admin", "moderator"], "targets": ["*"], "effect": "allow"}
      ],
      "default_effect": "deny",
      "caller": "moderator",
      "target": "posts.delete",
      "expected": true
    },
    {
      "id": "wildcard_target_pattern",
      "rules": [
        {"callers": ["*"], "targets": ["public.*"], "effect": "allow"}
      ],
      "default_effect": "deny",
      "caller": "anonymous",
      "target": "public.health",
      "expected": true
    },
    {
      "id": "compound_or_match",
      "rules": [
        {
          "callers": ["$or", "admin", "moderator"],
          "targets": ["*"],
          "effect": "allow"
        }
      ],
      "default_effect": "deny",
      "caller": "moderator",
      "target": "any",
      "expected": true
    },
    {
      "id": "compound_not_match",
      "rules": [
        {
          "callers": ["$not", "banned_user"],
          "targets": ["*"],
          "effect": "allow"
        }
      ],
      "default_effect": "deny",
      "caller": "good_user",
      "target": "any",
      "expected": true
    },
    {
      "id": "condition_role_match",
      "rules": [
        {
          "callers": ["*"],
          "targets": ["*"],
          "effect": "allow",
          "conditions": {
            "role": "editor"
          }
        }
      ],
      "default_effect": "deny",
      "caller": "user_123",
      "caller_identity": {"type": "user", "roles": ["editor"]},
      "target": "posts.edit",
      "expected": true
    },
    {
      "id": "condition_role_mismatch",
      "rules": [
        {
          "callers": ["*"],
          "targets": ["*"],
          "effect": "allow",
          "conditions": {
            "role": "admin"
          }
        }
      ],
      "default_effect": "deny",
      "caller": "user_123",
      "caller_identity": {"type": "user", "roles": ["viewer"]},
      "target": "posts.delete",
      "expected": false
    },
    {
      "id": "condition_identity_type_match",
      "rules": [
        {
          "callers": ["*"],
          "targets": ["*"],
          "effect": "allow",
          "conditions": {
            "identity_type": "service"
          }
        }
      ],
      "default_effect": "deny",
      "caller": "service_abc",
      "caller_identity": {"type": "service"},
      "target": "internal.sync",
      "expected": true
    },
    {
      "id": "condition_call_depth_match",
      "rules": [
        {
          "callers": ["*"],
          "targets": ["*"],
          "effect": "allow",
          "conditions": {
            "call_depth": {"lte": 2}
          }
        }
      ],
      "default_effect": "deny",
      "caller": "mod_a",
      "call_depth": 1,
      "target": "mod_b",
      "expected": true
    },
    {
      "id": "condition_call_depth_mismatch",
      "rules": [
        {
          "callers": ["*"],
          "targets": ["*"],
          "effect": "allow",
          "conditions": {
            "call_depth": {"lte": 1}
          }
        }
      ],
      "default_effect": "deny",
      "caller": "mod_b",
      "call_depth": 2,
      "target": "mod_c",
      "expected": false
    }
  ]
}
