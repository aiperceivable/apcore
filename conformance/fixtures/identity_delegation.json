      "id": "integral_numeric_depth_threshold",
      "input": {
        "identity": {"id": "user-1", "type": "user", "roles": [], "attrs": {}, "scopes": ["read"]},
        "rules": [
          {
            "callers": ["@external"],
            "targets": ["delegation.target"],
            "effect": "allow",
            "conditions": {"scopes": ["read"], "max_delegation_depth": 0.0}
          }
        ]
      },
      "expected": {"valid": true, "depth": 0, "subject_id": "user-1", "effect": "allow"}
    },
    {
      "id": "malformed_depth_denial_blocks_later_allow",
      "input": {
        "identity": {"id": "user-1", "type": "user", "roles": [], "attrs": {}, "scopes": ["read"]},
        "rules": [
          {
            "callers": ["@external"],
            "targets": ["delegation.target"],
            "effect": "deny",
            "conditions": {"max_delegation_depth": 9}
          },
          {"callers": ["@external"], "targets": ["delegation.target"], "effect": "allow", "conditions": {"scopes": ["read"]}}
        ]
      },
      "expected": {"valid": true, "depth": 0, "subject_id": "user-1", "effect": "deny"}
    },
