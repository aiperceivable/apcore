{
  "description": "Trusted delegation attenuates explicit scope and binds ACL access to the current actor and root subject.",
  "driver_contract": "Restore input.identity inside a native Context, then check the root subject and active depth. Where rules are supplied, evaluate an external caller targeting delegation.target using those rules and the supplied or default deny effect.",
  "test_cases": [
    {
      "id": "legacy_identity_preserves_acl",
      "input": {
        "identity": {"id": "agent-1", "type": "agent", "roles": ["runner"], "attrs": {}},
        "rules": [{"callers": ["@external"], "targets": ["delegation.target"], "effect": "allow"}]
      },
      "expected": {"valid": true, "depth": 0, "subject_id": "agent-1", "effect": "allow"}
    },
    {
      "id": "delegated_scope_and_subject_grant",
      "input": {
        "identity": {
          "id": "agent-1",
          "type": "agent",
          "roles": ["runner"],
          "attrs": {},
          "issuer": "https://id.example",
          "scopes": ["read"],
          "on_behalf_of": {
            "id": "user-1",
            "type": "user",
            "roles": ["approver"],
            "attrs": {},
            "issuer": "https://id.example",
            "scopes": ["deploy", "read"]
          }
        },
        "rules": [
          {
            "callers": ["@external"],
            "targets": ["delegation.target"],
            "effect": "allow",
            "conditions": {
              "scopes": ["read"],
              "identity_types": ["agent"],
              "roles": ["runner"],
              "subject_types": ["user"],
              "subject_roles": ["approver"],
              "max_delegation_depth": 1
            }
          }
        ]
      },
      "expected": {"valid": true, "depth": 1, "subject_id": "user-1", "effect": "allow"}
    },
    {
      "id": "insufficient_effective_scope",
      "input": {
        "identity": {
          "id": "agent-1",
          "type": "agent",
          "roles": ["runner"],
          "attrs": {},
          "issuer": "https://id.example",
          "scopes": ["read"],
          "on_behalf_of": {
            "id": "user-1",
            "type": "user",
            "roles": ["approver"],
            "attrs": {},
            "issuer": "https://id.example",
            "scopes": ["deploy", "read"]
          }
        },
        "rules": [
          {
            "callers": ["@external"],
            "targets": ["delegation.target"],
            "effect": "allow",
            "conditions": {"scopes": ["read", "deploy"]}
          }
        ]
      },
      "expected": {"valid": true, "depth": 1, "subject_id": "user-1", "effect": "deny"}
    },
    {
      "id": "subject_role_does_not_grant_actor_role",
      "input": {
        "identity": {
          "id": "agent-1",
          "type": "agent",
          "roles": ["runner"],
          "attrs": {},
          "issuer": "https://id.example",
          "scopes": ["read"],
          "on_behalf_of": {
            "id": "user-1",
            "type": "user",
            "roles": ["approver"],
            "attrs": {},
            "issuer": "https://id.example",
            "scopes": ["deploy", "read"]
          }
        },
        "rules": [
          {
            "callers": ["@external"],
            "targets": ["delegation.target"],
            "effect": "allow",
            "conditions": {"scopes": ["read"], "roles": ["approver"]}
          }
        ]
      },
      "expected": {"valid": true, "depth": 1, "subject_id": "user-1", "effect": "deny"}
    },
    {
      "id": "direct_identity_is_its_own_subject",
      "input": {
        "identity": {
          "id": "agent-1",
          "type": "agent",
          "roles": ["runner"],
          "attrs": {},
          "issuer": "https://id.example",
          "scopes": ["read"]
        },
        "rules": [
          {
            "callers": ["@external"],
            "targets": ["delegation.target"],
            "effect": "allow",
            "conditions": {
              "scopes": ["read"],
              "subject_types": ["agent"],
              "subject_roles": ["runner"],
              "max_delegation_depth": 0
            }
          }
        ]
      },
      "expected": {"valid": true, "depth": 0, "subject_id": "agent-1", "effect": "allow"}
    },
    {
      "id": "first_matching_unscoped_allow_denies",
      "input": {
        "identity": {
          "id": "agent-1",
          "type": "agent",
          "roles": ["runner"],
          "attrs": {},
          "issuer": "https://id.example",
          "scopes": ["read"],
          "on_behalf_of": {
            "id": "user-1",
            "type": "user",
            "roles": ["approver"],
            "attrs": {},
            "issuer": "https://id.example",
            "scopes": ["deploy", "read"]
          }
        },
        "rules": [
          {"callers": ["@external"], "targets": ["delegation.target"], "effect": "allow"},
          {
            "callers": ["@external"],
            "targets": ["delegation.target"],
            "effect": "allow",
            "conditions": {"scopes": ["read"]}
          }
        ]
      },
      "expected": {"valid": true, "depth": 1, "subject_id": "user-1", "effect": "deny"}
    },
    {
      "id": "compound_scope_does_not_grant",
      "input": {
        "identity": {
          "id": "agent-1",
          "type": "agent",
          "roles": ["runner"],
          "attrs": {},
          "issuer": "https://id.example",
          "scopes": ["read"],
          "on_behalf_of": {
            "id": "user-1",
            "type": "user",
            "roles": ["approver"],
            "attrs": {},
            "issuer": "https://id.example",
            "scopes": ["deploy", "read"]
          }
        },
        "rules": [
          {
            "callers": ["@external"],
            "targets": ["delegation.target"],
            "effect": "allow",
            "conditions": {"$or": [{"scopes": ["read"]}, {"roles": ["runner"]}]}
          }
        ]
      },
      "expected": {"valid": true, "depth": 1, "subject_id": "user-1", "effect": "deny"}
    },
