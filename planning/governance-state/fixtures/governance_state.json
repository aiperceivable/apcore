    {
      "id": "custom_step_named_acl_check_is_not_the_builtin",
      "note": "A custom step named `acl_check` that never consults an ACL, in a strategy otherwise like standard. builtin_acl_gate_wired MUST be false. This is the case that decides whether an implementation detects gates by type or by name \u2014 and a name-based implementation fails it in the ONE direction the flag must never fail in: reporting a gate that is not there.",
      "setup": {
        "sys_modules": {
          "enabled": true,
          "events": {
            "enabled": true
          }
        },
        "strategy": "custom_lookalike_acl_check",
        "acl": "attached",
        "approval_handler": null,
        "policy": null,
        "control_modules_declare_requires_approval": true
      },
      "expected": {
        "control_modules_registered": true,
        "read_modules_registered": true,
        "acl_configured": true,
        "builtin_acl_gate_wired": false,
        "approval_handler_configured": false,
        "builtin_approval_gate_wired": true,
        "policy_strict": false,
        "all_control_modules_require_approval": true,
        "unprotected_control_surface": true
      }
    },
    {
      "id": "both_gates_configured_and_wired",
      "note": "The fully-gated control case. Without it, an implementation hardcoding unprotected_control_surface=true passes most of the cases above.",
      "setup": {
        "sys_modules": {
          "enabled": true,
          "events": {
            "enabled": true
          }
        },
        "strategy": "standard",
        "acl": "attached",
        "approval_handler": "attached",
        "policy": null,
