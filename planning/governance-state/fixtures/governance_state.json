        "all_control_modules_require_approval": true,
        "unprotected_control_surface": false
      }
    },
    {
      "id": "handler_wired_but_control_modules_unannotated",
      "note": "THE case the v1.15.0 formula got wrong. Gate wired, handler attached \u2014 but the control modules do not declare requires_approval, so the gate returns before consulting the handler and nothing is gated. MUST be true. The published formula answered false.",
      "setup": {
        "sys_modules": {
          "enabled": true,
          "events": {
            "enabled": true
          }
        },
        "strategy": "standard",
        "acl": null,
        "approval_handler": "attached",
        "policy": null,
        "control_modules_declare_requires_approval": false
